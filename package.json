{
  "name": "dsh-asciinema",
  "version": "0.1.1",
  "description": "DSH plugin: record terminal/tool output as asciinema v2 (.cast), replay with an offline embedded player, and export HTML.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./assets/*": "./assets/*",
    "./cordis.yml": "./cordis.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "assets",
    "cordis.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --no-warnings tests/smoke.e2e.ts",
    "test:debug": "node --trace-warnings tests/smoke.e2e.ts",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "compatibility": {
      "node": ">=23.6.0",
      "dsh": ">=0.1.0"
    },
    "permissions": {
      "summary": "订阅 session/event 的 tool/result 输出录制为 asciinema v2 (.cast)；离线内嵌播放器回放 + HTML 导出。本地仅内存/会话数据，无网络无外部服务。",
      "commands": [
        "node <pkg>/lib/*.js (recorder/tools, in-process)"
      ],
      "writePaths": [
        "<castsDir>/*.cast（默认工作区 .casts/）",
        "导出 HTML 路径"
      ],
      "externalServices": [],
      "failureBoundaries": [
        "maxEvents/maxBytes 上限",
        "回放离线无外部请求"
      ],
      "lifecycleEvidence": [
        "16/16 smoke",
        "player.html 内嵌离线渲染"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "asciinema",
    "terminal-recording",
    "cast"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.5.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/988hj7tczd-oss/dsh-asciinema.git"
  }
}
